<?xml version="1.0" encoding="utf-8"?>
<!-- After an emergency: what has actually reached operations. Three steps, each an icon and a word (never colour alone). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface2" android:fillViewport="true" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout android:layout_width="96dp" android:layout_height="96dp" android:layout_marginTop="24dp" android:background="@drawable/circle_red_soft">
            <ImageView android:id="@+id/headIcon" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:src="@drawable/ic_warning" app:tint="@color/critical" android:contentDescription="@null" />
        </FrameLayout>
        <TextView android:id="@+id/title" style="@style/Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/subtitle" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <ImageView android:id="@+id/step1Icon" android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" />
                    <TextView android:id="@+id/step1Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/ink" android:textSize="15sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                    <ImageView android:id="@+id/step2Icon" android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" />
                    <TextView android:id="@+id/step2Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/ink" android:textSize="15sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                    <ImageView android:id="@+id/step3Icon" android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" />
                    <TextView android:id="@+id/step3Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/ink" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/mistakeResult" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mistake" style="@style/Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/callOps" style="@style/Button.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/sent_call_ops" app:icon="@drawable/ic_phone" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/done" style="@style/Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/sent_done" />
    </LinearLayout>
</ScrollView>
