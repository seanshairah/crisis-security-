{
  "title": "Crisis patrol request contracts",
  "authentication": "Device routes use the company device bearer token; admin routes require the portal session.",
  "routes": {
    "POST /api/patrols/events": {
      "body": "{ sentAt: ISO datetime, events: scan[] }",
      "maximumSubmitted": 100,
      "maximumProcessed": 20,
      "acknowledgements": ["ok", "duplicate", "rejected", "retry"],
      "notes": "Unacknowledged and retry rows must remain on the device. Missing/invalid sentAt requires clock review. Excessively delayed evidence requires review."
    },
    "POST /api/patrols/session": {
      "body": "{ guardNo: string, pin: string }",
      "note": "A shared device plus the scheduled guard and strong individual PIN is required."
    }
  },
  "schemas": {
    "policy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minIntervalMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "maxIntervalMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "responseMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "lookaheadMode": {
          "default": "DEFAULT",
          "type": "string",
          "enum": ["DEFAULT", "OFF", "AUTO", "CUSTOM"]
        },
        "lookaheadMinutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 5,
              "maximum": 240
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["enabled", "minIntervalMinutes", "maxIntervalMinutes", "responseMinutes"]
    },
    "checkpoint": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "radiusM": {
          "type": "integer",
          "minimum": 10,
          "maximum": 500
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "minimumVisits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["name", "latitude", "longitude", "radiusM", "priority", "minimumVisits"]
    },
    "scan": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "assignmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "qr": {
          "type": "string",
          "minLength": 20,
          "maxLength": 512
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "gpsCapturedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "latitude": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "longitude": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "accuracyM": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "mock": {
          "type": "boolean"
        }
      },
      "required": [
        "eventId",
        "sessionId",
        "assignmentId",
        "qr",
        "capturedAt",
        "latitude",
        "longitude",
        "accuracyM",
        "mock"
      ]
    }
  }
}
